---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';
export function getStaticPaths() { return projects.map(project => ({params: {slug: project.slug}, props: {project}})); }
const { project: p } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html><html lang="en"><head><BaseHead title={`${p.title} | Matthew Ho`} description={p.deck} /></head><body><Header /><main>
<a href={`${base}projects/`} class="back-link" data-site-base={base} aria-label="Back"><span aria-hidden="true">&lt;</span></a><p>Project {p.number} · {p.category}</p><h1>{p.title}</h1><p>{p.deck}</p>
<p><a href={`${base}notebooks/${p.notebook}`} download>Download notebook ↓</a> · <a href={`${base}projects/`}>All projects</a></p>
<p><strong>Data:</strong> {p.dataset}<br/><strong>Period:</strong> {p.year}<br/><strong>Tools:</strong> {p.tools.join(', ')}</p>
<section><h2>Question</h2><p>{p.question}</p></section>
<section><h2>Approach</h2><p>{p.method}</p><ol>{p.steps.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>
<section><h2>Findings and limitations</h2><h3>Observed finding</h3><p>{p.finding}</p><h3>What to keep in mind</h3><p>{p.limitation}</p><p><strong>Next iteration:</strong> {p.reflection}</p></section>
<section><h2>Selected figures</h2>{p.charts.map(chart => <figure><a href={`${base}${chart.src}`}><img src={`${base}${chart.src}`} alt={chart.alt} loading="lazy" /></a><figcaption>{chart.caption}</figcaption></figure>)}</section>
<section><h2>Notebook and source data</h2><p>The notebook preserves the analysis code with saved outputs removed and data paths normalized to a local data folder. Dataset files are not bundled; consult the notebook README and obtain appropriately licensed source data before running it.</p><ul>{p.dataFiles.map(file => <li>{file}</li>)}</ul><p><a href={`${base}notebooks/${p.notebook}`} download>Download notebook</a> · <a href={`${base}notebooks/README.md`}>Notebook README</a></p></section>
</main><Footer /><script is:inline>
  document.querySelector('.back-link')?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === location.origin && referrer.pathname.startsWith(event.currentTarget.dataset.siteBase) && history.length > 1) {
        event.preventDefault();
        history.back();
      }
    } catch { /* Direct visits use the Projects link. */ }
  });
</script></body></html>
<style>.back-link{position:fixed;left:max(4px, calc((100vw - 900px) / 2));top:50%;transform:translateY(-50%);z-index:10;display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;text-decoration:none;font-weight:bold;background:rgba(255,255,255,.95);border-radius:50%}.back-link:hover{text-decoration:underline}.back-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(max-width:850px){main{box-sizing:border-box;max-width:100%;width:100%;padding-left:56px;padding-right:16px}}figure{margin:2em 0}figcaption{color:rgb(var(--gray));font-size:.85em}h3{margin-bottom:.4em}</style>
