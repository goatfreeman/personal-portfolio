---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html><html lang="en"><head><BaseHead title="Projects | Matthew Ho" description="Explore Matthew Ho’s project collections." /></head><body><Header /><main class="portfolio-main"><section class="page-intro"><p class="eyebrow">THE ARCHIVE</p><h1>Projects<span class="accent-dot">.</span></h1><p>A home for the questions, experiments, and insights along the way.</p></section><section class="collection"><div class="folder-heading"><div><p class="eyebrow">PROJECT COLLECTION / 01</p><h2>ITCS 3162 portfolio</h2><p>Four course projects exploring data, models, and the limits of their conclusions.</p></div><span class="folder-count">4 PROJECTS</span></div><div class="card-grid">{projects.map(p => <article class="project-card"><div class="card-top"><span>{p.number} / {p.category}</span><span aria-hidden="true">↗</span></div><h3><a href={`${base}projects/${p.slug}/`}>{p.title}</a></h3><p>{p.deck}</p><span class="card-footer">VIEW PROJECT →</span></article>)}</div></section></main><Footer /></body></html>
