---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Projects | Matthew Ho" description="Explore Matthew Ho’s project collections." /></head>
  <body>
    <Header />
    <main>
      <h1>Projects</h1>
      <p>A home for the questions, experiments, and insights along the way.</p>
      <section class="standalone-project" aria-labelledby="standalone-title">
        <p class="collection-label">STANDALONE PROJECT</p>
        <h2 id="standalone-title"><a href={`${base}projects/quick-quote-builder/`}>Quick Quote Builder</a></h2>
        <p>A full-stack application for building, saving, and reviewing quotes.</p>
        <a class="project-link" href={`${base}projects/quick-quote-builder/`}>View project <span aria-hidden="true">→</span><span class="sr-only">: Quick Quote Builder</span></a>
      </section>
      <section class="project-collection" aria-labelledby="collection-title">
        <div class="collection-heading">
          <div><p class="collection-label">PROJECT COLLECTION / 01</p><h2 id="collection-title">ITCS 3162 portfolio</h2><p>Four course projects exploring data, models, and the limits of their conclusions.</p></div>
          <span class="collection-count">4 PROJECTS</span>
        </div>
        <div class="project-grid">
          {projects.map(p => <article class="project-block"><p class="category">{p.number} / {p.category}</p><h3><a href={`${base}projects/${p.slug}/`}>{p.title}</a></h3><p class="description">{p.deck}</p><a class="project-link" href={`${base}projects/${p.slug}/`}>View project <span aria-hidden="true">→</span><span class="sr-only">: {p.title}</span></a></article>)}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
main { width: 960px; }
.project-collection { background: rgba(var(--gray-light), 35%); border: 1px solid rgb(var(--gray-light)); border-radius: 14px; padding: 1.5rem; }
.standalone-project { background: rgba(var(--gray-light), 35%); border: 1px solid rgb(var(--gray-light)); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.5rem; }
.standalone-project h2 { font-size: 1.7rem; }
.standalone-project p:not(.collection-label) { margin: .5rem 0 1rem; }
.collection-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
.collection-heading h2 { font-size: 1.7rem; }
.collection-heading p:not(.collection-label) { margin: .5rem 0 1.4rem; }
.collection-label, .collection-count, .category, .project-link { font-size: .72rem; font-weight: bold; letter-spacing: .06em; }
.collection-label, .category { margin: 0 0 .7rem; color: rgb(var(--gray-dark)); }
.collection-count { white-space: nowrap; color: rgb(var(--gray-dark)); }
.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.project-block { background: white; border: 1px solid rgb(var(--gray-light)); border-radius: 10px; padding: 1.3rem; display: flex; flex-direction: column; }
.project-block h3 { font-size: 1.25rem; margin: 0 0 .65rem; }
.project-block h3 a { color: rgb(var(--black)); text-decoration: none; }
.project-block h3 a:hover { color: var(--accent); text-decoration: underline; }
.description { font-size: .9rem; margin: 0 0 1rem; }
.project-link { margin-top: auto; text-transform: uppercase; text-decoration: none; }
.project-link:hover { text-decoration: underline; }
@media (max-width: 720px) { .project-collection { padding: 1rem; } .collection-heading { flex-direction: column; gap: .3rem; } .project-grid { grid-template-columns: 1fr; } }
</style>
