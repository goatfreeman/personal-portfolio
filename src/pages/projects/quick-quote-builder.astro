---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Quick Quote Builder | Matthew Ho" description="A full-stack application for building and reviewing quotes." /></head>
<body><Header /><main>
  <a href={`${base}projects/`} class="back-link" data-site-base={base} aria-label="Back"><span aria-hidden="true">&lt;</span></a>
  <p>Standalone project · Full-stack web application</p>
  <h1>Quick Quote Builder</h1>
  <p>A web application that brings item selection, quote calculations, and review into one workflow.</p>
  <section><h2>Overview</h2><p>Quick Quote Builder supports the process of assembling equipment and labor quotes. Users can select items, customize quote lines, save drafts, and review finalized quotes.</p></section>
  <section><h2>Application preview</h2><figure><a class="image-preview-trigger" href={`${base}images/quick-quote-builder-screen.png`} aria-label="Enlarge Quick Quote Builder screenshot"><img src={`${base}images/quick-quote-builder-screen.png`} alt="Quick Quote Builder equipment selection screen with item catalog, quote workspace and compatibility ledger" /></a><figcaption>Equipment selection screen. Select the image to enlarge it.</figcaption></figure><dialog id="image-preview" aria-label="Quick Quote Builder screenshot preview"><button type="button" class="preview-close" aria-label="Close image preview">×</button><img src={`${base}images/quick-quote-builder-screen.png`} alt="Enlarged equipment selection screen with item catalog, quote workspace and compatibility ledger" /></dialog></section>
  <section><h2>Key capabilities</h2><ul>
    <li>Build quotes from catalog items and customize individual lines.</li>
    <li>Calculate labor, margin, and tax as part of the quote workflow.</li>
    <li>Save drafts and review finalized quotes, with templates to help organize repeat work.</li>
    <li>Use authentication workflows with Supabase Auth and Microsoft/Azure SSO routing.</li>
  </ul></section>
  <section><h2>My role</h2><p>As Full-Stack Web Application Developer, I developed the quote workflows and designed Supabase PostgreSQL data structures for catalogs, templates, quotes, revisions, and application settings. I implemented authentication workflows and applied defensive programming to handle invalid inputs, missing files, and unexpected behavior.</p></section>
  <section><h2>Tools</h2><p>Next.js, React, TypeScript, Supabase PostgreSQL, and Supabase Auth.</p></section>
</main><Footer />
<script is:inline>
  const preview = document.querySelector('#image-preview');
  const previewTrigger = document.querySelector('.image-preview-trigger');
  previewTrigger?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !preview?.showModal) return;
    event.preventDefault();
    preview.showModal();
  });
  preview?.querySelector('.preview-close')?.addEventListener('click', () => preview.close());
  preview?.addEventListener('click', (event) => { if (event.target === preview) preview.close(); });
  preview?.addEventListener('close', () => previewTrigger?.focus({preventScroll: true}));
  document.querySelector('.back-link')?.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === location.origin && referrer.pathname.startsWith(event.currentTarget.dataset.siteBase) && history.length > 1) {
        event.preventDefault();
        history.back();
      }
    } catch { /* Direct visits use the Projects link. */ }
  });
</script></body></html>
<style>
figure{margin:1.5em 0} figure img{display:block;width:100%;height:auto;box-shadow:var(--box-shadow)} figcaption{color:rgb(var(--gray));font-size:.8em;margin-top:.6em}
#image-preview{position:fixed;width:min(94vw,1400px);max-width:94vw;max-height:90vh;padding:3.2rem 1rem 1rem;box-sizing:border-box;border:0;border-radius:12px;background:#fff;overflow:auto}#image-preview::backdrop{background:rgba(0,0,0,.8)}#image-preview img{display:block;width:100%;height:auto}.preview-close{position:absolute;top:.4rem;right:.6rem;min-width:44px;min-height:44px;border:0;border-radius:50%;background:#edf0f7;color:#26354a;font-size:1.8rem;cursor:pointer}.preview-close:focus-visible,.image-preview-trigger:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.back-link{position:fixed;left:max(4px, calc((100vw - 900px) / 2));top:90px;z-index:10;display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;text-decoration:none;font-weight:bold;background:#edf0f7;color:#566682;border-radius:50%}
.back-link:hover{text-decoration:underline}
.back-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media(max-width:850px){main{box-sizing:border-box;max-width:100%;width:100%;padding-left:56px;padding-right:16px}}
</style>
