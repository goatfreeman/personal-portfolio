---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import projects from '../data/projects.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html><html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header /><main class="portfolio-main">
<section class="hero"><div><p class="eyebrow">MATTHEW HO / PORTFOLIO</p><h1>Curiosity, meet <em>data.</em></h1><p class="hero-copy">A collection of projects exploring data, models, and the questions behind the numbers.</p><div class="actions"><a class="button" href={`${base}projects/`}>Explore projects <span aria-hidden="true">↗</span></a><a class="text-link" href={`${base}about/`}>More about me →</a></div></div><div class="hero-aside" aria-hidden="true"><span>THE WORK</span><strong>Ideas into<br/>insights.</strong><div class="art-lines"><i></i><i></i><i></i><i></i><i></i></div><small>DATA / ANALYSIS / LEARNING</small></div></section>
<section class="updates"><div><p class="eyebrow">A NOTE FROM ME</p><h2>What’s happening</h2></div><div><p>Explore my ITCS 3162 portfolio and the four data projects it brings together.</p><a href={`${base}projects/`}>Browse the collection →</a></div></section>
<section id="projects" class="project-section"><div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>Projects to explore</h2><p>Four projects from ITCS 3162. Project dates have not been provided, so these are not ordered by recency.</p></div><a href={`${base}projects/`}>View collection →</a></div><div class="card-grid">{projects.map(p => <article class="project-card"><div class="card-top"><span>{p.number} / {p.category}</span><span aria-hidden="true">↗</span></div><h3><a href={`${base}projects/${p.slug}/`}>{p.title}</a></h3><p>{p.deck}</p><span class="card-footer">VIEW PROJECT →</span></article>)}</div></section>
</main><Footer /></body></html>
