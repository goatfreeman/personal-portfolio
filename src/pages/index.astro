---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import projects from '../data/projects.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html><html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header /><main>
<h1>Data portfolio</h1><p>Matthew Ho · UNC Charlotte · ITCS 3162</p><p>Four course projects exploring data, models, and the limits of their conclusions.</p>
<section id="projects"><h2>Projects</h2>{projects.map(p => <article><p>{p.number} · {p.category}</p><h3><a href={`${base}projects/${p.slug}/`}>{p.title}</a></h3><p>{p.deck}</p></article>)}</section>
</main><Footer /></body></html>
