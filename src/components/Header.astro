---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const path = Astro.url.pathname;
const active = path.startsWith(`${base}projects`) ? 'projects' : path.startsWith(`${base}about`) ? 'about' : 'home';
---
<header class="site-header"><nav aria-label="Main navigation" class="nav-inner"><a class="brand" href={base}><span class="brand-mark" aria-hidden="true">MH</span><span>Matthew Ho<small>Data portfolio</small></span></a><div class="nav-links"><a href={base} aria-current={active === 'home' ? 'page' : undefined}>Home</a><a href={`${base}about/`} aria-current={active === 'about' ? 'page' : undefined}>About Me</a><a href={`${base}projects/`} aria-current={active === 'projects' ? 'page' : undefined}>Projects</a></div></nav></header>
