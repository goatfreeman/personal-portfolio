---
import { SITE_TITLE } from '../consts';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<header><nav><h2><a href={base}>{SITE_TITLE}</a></h2><a href={`${base}#projects`}>Projects</a></nav></header>
<style>
header{margin:0;padding:0 1em;background:white;box-shadow:0 2px 8px rgba(var(--black),5%)} nav{display:flex;align-items:center;justify-content:space-between;gap:1em} h2{margin:0;font-size:1em} nav a{display:block;padding:1em .5em;text-decoration:none;color:rgb(var(--black))}
</style>
